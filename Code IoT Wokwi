void buzzerOn() {
  ledcAttach(BUZZER_PIN, 2000, 8);
  ledcWrite(BUZZER_PIN, 128);
}
 
void buzzerOff() {
  ledcWrite(BUZZER_PIN, 0);
  ledcDetach(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
}
